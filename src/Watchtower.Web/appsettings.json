{
  "ConnectionStrings": {
    "Watchtower": "Host=localhost;Port=5432;Database=watchtower;Username=watchtower;Password=watchtower"
  },
  "Ingestion": {
    "QueueCapacity": 10000,
    "BatchSize": 500
  },
  "Detection": {
    "BruteForce": {
      "Threshold": 5,
      "WindowMinutes": 15
    },
    "OffHours": {
      "BusinessStartHour": 8,
      "BusinessEndHour": 18
    },
    "PrivilegeEscalation": {
      "AuthorizedActors": [ "admin", "root", "svc_backup" ]
    },
    "ImpossibleTravel": {
      "WindowMinutes": 60
    }
  },
  "Telegram": {
    "BotToken": "",
    "ChatId": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
